# Financial Access Intelligence Layer — Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR PRIVATE KEYS TO VERSION CONTROL

# ==============================================================================
# 1. APPLICATION & ENVIRONMENT SETTINGS
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_base64_string_in_production
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# ==============================================================================
# 2. DATABASE CONFIGURATION (POSTGRESQL)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fail_user
POSTGRES_PASSWORD=fail_password_secure
POSTGRES_DB=fail_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==============================================================================
# 3. CACHE & EVENT BUS (REDIS)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ==============================================================================
# 4. FAI SCORING ENGINE CONFIGURATION
# ==============================================================================
DEFAULT_SCORING_METHODOLOGY=DETERMINISTIC_RULES  # Options: DETERMINISTIC_RULES, STATISTICAL_COHORT, ML_XGBOOST, NON_LINEAR_MCDA
WEIGHT_VECTOR_CONFIG_PATH=config/weights.yaml

# ==============================================================================
# 5. OPEN PAYMENTS ANTI-CORRUPTION LAYER (ACL) CONFIGURATION
# ==============================================================================
OPEN_PAYMENTS_CLIENT_KEY_ID=key-id-001
OPEN_PAYMENTS_PRIVATE_KEY_PATH=keys/private.key
OPEN_PAYMENTS_KEY_ALGORITHM=Ed25519
OPEN_PAYMENTS_WALLET_ADDRESS=https://ilp.wallet.example.com/fail-agent
OPEN_PAYMENTS_AUTH_SERVER_URL=https://auth.wallet.example.com
OPEN_PAYMENTS_TIMEOUT_SECONDS=10
